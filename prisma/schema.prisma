generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  AGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum VerificationType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ChatbotStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum ConversationStatus {
  OPEN
  AI_ACTIVE
  HUMAN_TAKEOVER
  RESOLVED
  CLOSED
}

enum MessageSender {
  VISITOR
  AI
  AGENT
  SYSTEM
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum DocumentSourceType {
  PDF
  TXT
  MARKDOWN
  DOCX
  URL
  SITEMAP
  PASTED_TEXT
  FAQ
  CSV
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum CreditLedgerType {
  GRANT
  USAGE
  REFUND
  ADJUSTMENT
  RESET
  PURCHASE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentProvider {
  STRIPE
  MIDTRANS
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ApiKeyType {
  SECRET
  PUBLIC_WIDGET
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  imageUrl        String?
  platformRole    PlatformRole  @default(USER)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  sessions               Session[]
  accounts               Account[]
  memberships            OrganizationMember[]
  ownedOrganizations     Organization[]       @relation("OrganizationOwner")
  invitationsSent        Invitation[]         @relation("InvitationInviter")
  assignedConversations  Conversation[]       @relation("ConversationAssignee")
  internalNotes          InternalNote[]
  auditLogs              AuditLog[]
  apiKeys                ApiKey[]
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  tokenHash            String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessTokenEnc    String?
  refreshTokenEnc   String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  id         String           @id @default(cuid())
  identifier String
  tokenHash  String           @unique
  type       VerificationType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([identifier, type])
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner          User                   @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members        OrganizationMember[]
  invitations    Invitation[]
  chatbots       Chatbot[]
  knowledgeBases KnowledgeBase[]
  conversations  Conversation[]
  leads          Lead[]
  documents      Document[]
  subscription   Subscription?
  creditAccount  CreditAccount?
  usageRecords   UsageRecord[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]

  @@index([ownerId])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([organizationId, email])
  @@index([email, status])
}

model Chatbot {
  id             String        @id @default(cuid())
  organizationId String
  publicId       String        @unique @default(cuid())
  name           String
  description    String?
  status         ChatbotStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configuration  ChatbotConfiguration?
  knowledgeLinks ChatbotKnowledgeBase[]
  conversations  Conversation[]

  @@index([organizationId, status])
}

model ChatbotConfiguration {
  id                  String   @id @default(cuid())
  chatbotId           String   @unique
  avatarUrl           String?
  brandColor          String   @default("#2563EB")
  welcomeMessage      String   @default("Hi! How can I help you today?")
  systemInstructions  String   @default("")
  persona             String?
  languages           String[] @default(["en"])
  provider            String   @default("openai")
  model               String   @default("gpt-4.1-mini")
  temperature         Float    @default(0.4)
  maxResponseTokens   Int      @default(512)
  historyLimit        Int      @default(20)
  fallbackMessage     String   @default("I am not sure I can help with that. Would you like to speak with a teammate?")
  suggestedQuestions  String[] @default([])
  conversationLimit   Int?
  collectLeads        Boolean  @default(false)
  leadFields          Json?
  humanHandoffEnabled Boolean  @default(false)
  handoffMessage      String?
  allowedDomains      String[] @default([])
  showSources         Boolean  @default(true)
  removeBranding      Boolean  @default(false)
  fallbackEnabled     Boolean  @default(false)
  fallbackProvider    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  chatbot             Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
}

model KnowledgeBase {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]
  chatbotLinks   ChatbotKnowledgeBase[]

  @@index([organizationId])
}

model ChatbotKnowledgeBase {
  chatbotId       String
  knowledgeBaseId String
  chatbot         Chatbot       @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([chatbotId, knowledgeBaseId])
}

model Document {
  id              String             @id @default(cuid())
  organizationId  String
  knowledgeBaseId String
  title           String
  sourceType      DocumentSourceType
  storageKey      String?
  mimeType        String?
  byteSize        Int?
  sourceUrl       String?
  status          DocumentStatus     @default(PENDING)
  errorMessage    String?
  extractedText   String?
  attempts        Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]

  @@index([organizationId, knowledgeBaseId])
  @@index([status])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  tokenCount Int?
  chunkIndex Int
  metadata     Json?
  embedding    Json?
  embeddingVec Unsupported("vector")?
  createdAt    DateTime @default(now())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model VisitorSession {
  id             String         @id @default(cuid())
  publicId       String         @unique @default(cuid())
  tokenHash      String         @unique
  organizationId String?
  chatbotId      String?
  origin         String?
  userAgent      String?
  ipHash         String?
  createdAt      DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())
  conversations  Conversation[]

  @@index([chatbotId])
}

model Conversation {
  id               String             @id @default(cuid())
  organizationId   String
  chatbotId        String
  visitorSessionId String?
  status           ConversationStatus @default(AI_ACTIVE)
  assignedToId     String?
  unreadByTeam     Boolean            @default(true)
  startedAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  closedAt         DateTime?
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chatbot          Chatbot            @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  visitorSession   VisitorSession?    @relation(fields: [visitorSessionId], references: [id], onDelete: SetNull)
  assignedTo       User?              @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages         Message[]
  handoffs         HumanHandoff[]
  notes            InternalNote[]
  lead             Lead?

  @@index([organizationId, status])
  @@index([chatbotId])
  @@index([assignedToId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  agentId        String?
  content        String
  citations      Json?
  usage          Json?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model HumanHandoff {
  id              String       @id @default(cuid())
  conversationId  String
  requestedAt     DateTime     @default(now())
  acceptedAt      DateTime?
  resolvedAt      DateTime?
  requestedReason String?
  acceptedById    String?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model InternalNote {
  id             String       @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  conversationId String       @unique
  name           String?
  email          String?
  phone          String?
  fields         Json?
  consentedAt    DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Plan {
  id                String         @id @default(cuid())
  code              String         @unique
  name              String
  description       String
  monthlyPriceCents Int
  yearlyPriceCents  Int
  currency          String         @default("USD")
  isActive          Boolean        @default(true)
  sortOrder         Int            @default(0)
  limits            Json
  features          Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  subscriptions     Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  billingInterval        BillingInterval    @default(MONTHLY)
  provider               PaymentProvider    @default(STRIPE)
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  trialEndsAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])
  payments               Payment[]
  invoices               Invoice[]
}

model Payment {
  id                String          @id @default(cuid())
  organizationId    String
  subscriptionId    String?
  provider          PaymentProvider
  providerPaymentId String?         @unique
  status            PaymentStatus
  amountCents       Int
  currency          String          @default("USD")
  idempotencyKey    String          @unique
  rawEventId        String?
  createdAt         DateTime        @default(now())
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Invoice {
  id                String        @id @default(cuid())
  organizationId    String
  subscriptionId    String?
  provider          PaymentProvider
  providerInvoiceId String?       @unique
  amountCents       Int
  currency          String        @default("USD")
  hostedUrl         String?
  pdfUrl            String?
  status            String
  createdAt         DateTime      @default(now())
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
}

model CreditAccount {
  id              String              @id @default(cuid())
  organizationId  String              @unique
  balance         Int                 @default(0)
  lifetimeGranted Int                 @default(0)
  lifetimeUsed    Int                 @default(0)
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledger          CreditLedgerEntry[]
}

model CreditLedgerEntry {
  id              String           @id @default(cuid())
  creditAccountId String
  type            CreditLedgerType
  amount          Int
  balanceAfter    Int
  reason          String
  idempotencyKey  String           @unique
  usageRecordId   String?
  createdAt       DateTime         @default(now())
  createdById     String?
  creditAccount   CreditAccount    @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([creditAccountId, createdAt])
}

model UsageRecord {
  id                  String       @id @default(cuid())
  organizationId      String
  chatbotId           String?
  provider            String
  model               String
  inputTokens         Int          @default(0)
  outputTokens        Int          @default(0)
  credits             Int          @default(0)
  estimatedCostMicros Int          @default(0)
  requestId           String?      @unique
  createdAt           DateTime     @default(now())
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AIProviderConfiguration {
  id              String   @id @default(cuid())
  organizationId  String?
  provider        String
  encryptedApiKey String?
  isPlatformManaged Boolean @default(true)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, provider])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           ApiKeyType
  name           String
  prefix         String
  keyHash        String       @unique
  scopes         String[]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model WebhookEvent {
  id            String    @id @default(cuid())
  provider      String
  eventId       String
  eventType     String
  processedAt   DateTime?
  status        String
  errorMessage  String?
  payloadDigest String
  createdAt     DateTime  @default(now())

  @@unique([provider, eventId])
}

model BackgroundJob {
  id         String    @id @default(cuid())
  type       String
  status     JobStatus @default(QUEUED)
  payload    Json
  error      String?
  attempts   Int       @default(0)
  runAt      DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, runAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt
}

model OutboundEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  textBody  String
  htmlBody  String?
  purpose   String
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}
